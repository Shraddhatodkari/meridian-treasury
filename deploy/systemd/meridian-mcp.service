[Unit]
Description=Meridian MCP tool server (streamable HTTP)
After=network-online.target

[Service]
User=meridian
WorkingDirectory=/opt/meridian
EnvironmentFile=/etc/meridian/meridian.env
ExecStart=/opt/meridian/.venv/bin/python -m meridian.mcp_server --http 8200 --host 127.0.0.1
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
