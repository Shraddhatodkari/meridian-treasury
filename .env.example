# ---- Mode -------------------------------------------------------------------------------------------
# demo        : SYNTHETIC demo company + bundled snapshot of real public market data; offline; demo sign-ins
# production  : client data only (meridian ingest), MongoDB required, real Claude endpoint, signing key required.
#               Run `meridian doctor` — production refuses to start on any FAIL.
MERIDIAN_MODE=demo

# ---- AI (keys come from the environment / secret manager, never from code) ---------------------------
# auto (default): Claude via the Anthropic API when ANTHROPIC_API_KEY is set; otherwise AI OFFLINE / DETERMINISTIC.
# mock forces offline; vertex / bedrock use cloud credentials. Never put keys in code or in this file in git.
MERIDIAN_LLM_PROVIDER=auto            # auto | mock | anthropic | vertex | bedrock
# ANTHROPIC_API_KEY=
# MERIDIAN_LLM_MODEL=claude-sonnet-4-5  # use the model id of your platform; verify with `meridian llm-check`
# MERIDIAN_GCP_PROJECT=my-project      # vertex
# MERIDIAN_AWS_REGION=us-east-1        # bedrock

# ---- Persistence & identity --------------------------------------------------------------------------
# MERIDIAN_MONGODB_URI=mongodb+srv://...   (MongoDB Atlas; required in production; enables $vectorSearch)
# MERIDIAN_JWT_SECRET=                     (32+ random bytes; required in production)
# MERIDIAN_API_KEYS=                       (optional service keys key:role:user,...; demo keys are used only in demo mode)

# ---- Data --------------------------------------------------------------------------------------------
MERIDIAN_MARKET_DATA=snapshot          # snapshot (dated real public data, reproducible) | live | none
# MERIDIAN_SEC_USER_AGENT="Org Name contact@org.com"   (SEC EDGAR fair-access policy; needed for live peers)
MERIDIAN_EMBEDDER=hashing             # hashing | transformer (pip install -e ".[nlp]")
# MERIDIAN_GIT_SHA=                     (release id recorded in reproducibility metadata)

# ---- Runtime ----------------------------------------------------------------------------------------
# MERIDIAN_WARMUP=1                   (pre-compute analytics in a background thread at start-up; 0 disables, used in tests)

# ---- Public-company case (primary) -----------------------------------------------------------------
# The PUBLIC · REAL case (Caterpillar Inc., SEC EDGAR XBRL) ships as a dated, checksummed snapshot.
# Refresh it from SEC EDGAR with:  python scripts/refresh_public_company.py   (uses MERIDIAN_SEC_USER_AGENT)
# MERIDIAN_STARTUP_REVIEW=1   (scheduled base-case review of the public company at start-up; 0 disables)
